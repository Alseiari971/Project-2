+/// A partition file seen at the container's global offsets: compression block offsets count across
+/// all partitions, so partition N starts at N * partition_size.
+struct PartitionView<'a> {
+    file: &'a mut fs::File,
+    base: u64,
+}
+impl Read for PartitionView<'_> {
+    fn read(&mut self, buf: &mut [u8]) -> std::io::Result<usize> {
+        self.file.read(buf)
+    }
+}
+impl Seek for PartitionView<'_> {
+    fn seek(&mut self, pos: SeekFrom) -> std::io::Result<u64> {
+        let local = match pos {
+            SeekFrom::Start(p) => SeekFrom::Start(p.checked_sub(self.base).ok_or_else(|| std::io::Error::other("offset is before this .ucas partition"))?),
+            other => other,
+        };
+        Ok(self.file.seek(local)? + self.base)
+    }
+}
