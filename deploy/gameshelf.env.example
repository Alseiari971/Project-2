# GameShelf settings: every option, with what it does. The VPS setup script
# copies this file to /etc/gameshelf.env.example; your real settings are in
# /etc/gameshelf.env. Edit with:  nano /etc/gameshelf.env
# then apply with:                systemctl restart gameshelf
NODE_ENV=production
PORT=3000
DB_FILE=/var/lib/gameshelf/gameshelf.db
# The site's address, for Steam's sign-in and links in emails.
PUBLIC_URL=https://gameshelf.ae

# ---- Game data ----
# Steam's store and Wikidata (CC0): no keys needed. Twitch/IGDB keys are no longer used.
# How long fetched game data is reused before asking Steam and Wikidata again.
METADATA_TTL_DAYS=7
# GAME_DATA=local uses the built-in 35-game sample instead (offline, for development).
GAME_DATA=

# ---- Steam ----
# "Import from Steam" and Steam names on linked accounts (https://steamcommunity.com/dev/apikey):
STEAM_API_KEY=

# ---- Email (GameShelf Guard codes, password resets, alerts) ----
SMTP_URL=
MAIL_FROM=

# ---- Shared Arabic translation (https://platform.openai.com/api-keys) ----
OPENAI_API_KEY=
# Free plan: new lines per player per day, and new games a day the AI may start on.
TRANSLATE_DAILY_LINES=2000
FREE_DAILY_BUILDS=1
# GameShelf Supporter: new lines per player per month (and per day, so one month can't go in an hour).
SUPPORTER_MONTHLY_STRINGS=150000
SUPPORTER_DAILY_LINES=30000
# All players together: characters per month (protects the OpenAI bill).
TRANSLATE_MONTHLY_CHARS=3000000

# ---- GameShelf Supporter (داعم) ----
# Boost tokens a supporter gets each month to push requested games up the queue.
SUPPORTER_MONTHLY_BOOSTS=5
# Payment webhooks (POST /api/billing/webhook): the signing secret from each provider.
STRIPE_WEBHOOK_SECRET=
LEMONSQUEEZY_WEBHOOK_SECRET=
# Where the Pricing page's buttons go (your checkout or payment links: Stripe, LemonSqueezy, Ziina, Tabby...).
CHECKOUT_URL_MONTHLY=
CHECKOUT_URL_YEARLY=

# ---- Store affiliate links (optional) ----
# Added to outbound links for those stores; links still say rel="sponsored".
AFFILIATE_GOG_ID=
AFFILIATE_HUMBLE_ID=
AFFILIATE_FANATICAL_ID=
AFFILIATE_GMG_ID=
AFFILIATE_EPIC_CREATOR_CODE=

# ---- Admins and downloads ----
# Your username on the site (comma separated for more): admins get the Admin Panel.
ADMIN_USERS=
# Where the website's Windows download button goes when no installer was uploaded in the Admin Panel.
DOWNLOAD_URL=
