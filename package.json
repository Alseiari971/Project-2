{
  "name": "gameshelf",
  "version": "0.1.0",
  "description": "Discover every game, find where to buy it, and share the games you've played.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "app": "electron desktop/main.js",
    "dist": "npm run dist:win",
    "test": "node --test",
    "search-debug": "node scripts/search-debug.js",
    "dist:win": "node scripts/prepare-dist.js && electron-builder --win nsis"
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "app.gameshelf.desktop",
    "productName": "GameShelf",
    "copyright": "GameShelf",
    "extraMetadata": {
      "main": "desktop/main.js"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "package.json",
      "server.js",
      "src/**/*",
      "public/**/*",
      "data/games.json",
      "desktop/**/*",
      "scripts/localization-pack.js"
    ],
    "asarUnpack": [
      "scripts/localization-pack.js",
      "desktop/localization/pack.js",
      "desktop/localization/files.js",
      "desktop/localization/reengine.js"
    ],
    "extraResources": [
      {
        "from": "build-tools/arabic-builder",
        "to": "arabic-builder"
      },
      {
        "from": "desktop/localization/ocr-helper.ps1",
        "to": "ocr-helper.ps1"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/icon.png"
    },
    "nsis": {
      "artifactName": "GameShelf-Setup.${ext}",
      "shortcutName": "GameShelf",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "mac": {
      "icon": "desktop/icon.png",
      "category": "public.app-category.entertainment"
    },
    "linux": {
      "icon": "desktop/icon.png",
      "category": "Game"
    }
  }
}
