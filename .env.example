# Copy this file to .env and fill it in.

# Free key from https://rawg.io/apidocs. Unlocks searching every game in the world.
# Leave empty to use the small built-in sample catalog.
RAWG_API_KEY=

# Free key from https://steamcommunity.com/dev/apikey. Turns on "Import from Steam".
# Any domain name works when registering it, e.g. localhost.
STEAM_API_KEY=

# Port the website runs on.
PORT=3000
