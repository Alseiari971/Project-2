# Copy this file to .env and fill it in.

# Game data comes from Steam's store and Wikidata, with no keys.
# GAME_DATA=local uses the 35-game sample instead (offline); GAME_DATA=rawg uses RAWG.
GAME_DATA=
# Days Steam and Wikidata details are kept before they're fetched again.
METADATA_TTL_DAYS=7
RAWG_API_KEY=

# Free key from https://steamcommunity.com/dev/apikey. Turns on "Import from Steam".
# Any domain name works when registering it, e.g. localhost.
STEAM_API_KEY=

# Port the website runs on.
PORT=3000

# Optional: test the desktop app's Discord activity with a different Discord
# application than the one in desktop/config.json.
DISCORD_CLIENT_ID=

# Admins (usernames, comma separated) and, optionally, Supporter payments and
# affiliate links. Every setting is explained in deploy/gameshelf.env.example.
ADMIN_USERS=
STRIPE_WEBHOOK_SECRET=
LEMONSQUEEZY_WEBHOOK_SECRET=
CHECKOUT_URL_MONTHLY=
CHECKOUT_URL_YEARLY=
