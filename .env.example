# Copy this file to .env and fill it in.

# IGDB (run by Twitch): every game on every platform, with official cover art.
# Free: register an app at https://dev.twitch.tv/console/apps (see the README).
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Optional older alternative to IGDB. Only used when the IGDB settings are empty.
RAWG_API_KEY=

# Free key from https://steamcommunity.com/dev/apikey. Turns on "Import from Steam".
# Any domain name works when registering it, e.g. localhost.
STEAM_API_KEY=

# Port the website runs on.
PORT=3000

# Optional: Discord activity in the desktop app (see README)
DISCORD_CLIENT_ID=
